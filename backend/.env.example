# ─── Server ───────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
# Get your connection string from MongoDB Atlas → Connect → Drivers
MONGO_URI=your_mongodb_atlas_connection_string_here

# ─── JWT ──────────────────────────────────────────────
# A long, random secret string used to sign JWTs.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ─── Groq AI ──────────────────────────────────────────────────────────────────
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ─── AWS S3 (for file uploads) ────────────────────────
# Create an IAM user with S3 permissions and grab the access keys
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_s3_bucket_name_here
