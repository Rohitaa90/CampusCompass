# ⚠️  IMPORTANT: NEVER commit this file. It contains secrets.
# Copy this to .env and fill in your values.

# When running on a physical device via Expo Go:
# - DO NOT use http://localhost:5000 (localhost refers to the phone itself!)
# - Run `ipconfig` on Windows to find your WiFi IPv4 Address
# - Use that IP instead, e.g. http://192.168.1.10:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api
